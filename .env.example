NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local development uses durable PGlite under web/.data when DATABASE_URL is empty.
DATABASE_URL=
# Required in production; local development generates a persistent secret under .data.
SESSION_SECRET=
# Set this before using the organizer login in a later phase.
ADMIN_SECRET=
# Use real Turnstile keys for a protected public sale. Cloudflare's documented
# test keys make the local widget flow testable but provide no bot resistance.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
